# Copy to .env and adjust for your environment. Never commit the real .env.

APP_ENV=development
APP_DEBUG=false
APP_NAME="Library Management System"
APP_VERSION=5.0.0

# For local dev, SQLite is fine. For production, point at PostgreSQL, e.g.:
#   DATABASE_URL=postgresql+psycopg2://lms_user:lms_password@localhost:5432/library
DATABASE_URL=sqlite:///./data/library.db

# Generate a strong random secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI_PROVIDER=mock requires no external service or API key at all.
# AI_PROVIDER=anthropic requires AI_API_KEY and the `anthropic` package.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

DEFAULT_LOAN_PERIOD_DAYS=14
MAX_RENEWALS=2
FINE_PER_DAY=5.0

RATE_LIMIT_PER_MINUTE=120
